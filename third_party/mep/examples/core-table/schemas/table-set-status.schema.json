{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Table set status request parameters",
  "type": "object",
  "properties": {
    "rowIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,100}$"
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "todo",
        "done"
      ]
    }
  },
  "required": [
    "rowIds",
    "status"
  ],
  "additionalProperties": false
}
